; Engine configuration file.
config_version=5

[application]
config/name="Abyss Diver Girls"
config/description="2.5D 俯视角机甲搜打撤原型"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")

[autoload]
PixelUI="*res://scripts/pixel_ui.gd"
Loc="*res://scripts/loc.gd"
GameData="*res://scripts/game_data.gd"
Events="*res://scripts/events.gd"
Audio="*res://scripts/audio/audio_manager.gd"
Story="*res://scripts/story/story.gd"
Progress="*res://scripts/progression/progress.gd"
Net="*res://scripts/net/session.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input_devices]
pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true

[gui]

timers/tooltip_delay_sec=0.05

theme/custom_font="res://assets/fonts/hd2_ui_sc.ttf"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]
limits/opengl/max_lights_per_object.web=4
renderer/rendering_method.web="gl_compatibility"
reflections/reflection_atlas/reflection_count=4
textures/canvas_textures/default_texture_filter=2
anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/msaa_3d.mobile=0
anti_aliasing/quality/screen_space_aa=0
anti_aliasing/screen_space_roughness_limiter/enabled=true
anti_aliasing/screen_space_roughness_limiter/enabled.mobile=true
anti_aliasing/screen_space_roughness_limiter/amount=0.45
anti_aliasing/screen_space_roughness_limiter/limit=0.22
textures/default_filters/anisotropic_filtering_level=4
textures/default_filters/anisotropic_filtering_level.mobile=2
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/size.mobile=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=1
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=2
lights_and_shadows/positional_shadow/soft_shadow_filter_quality.mobile=1

[shader_globals]

mech_damage={
"type": "float",
"value": 0.0
}
weather_wet={
"type": "float",
"value": 0.0
}
weather_rain={
"type": "float",
"value": 0.0
}
sun_dir_world={
"type": "vec3",
"value": Vector3(0.45, 0.62, 0.64)
}
occ_cam_pos={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
occ_mech_pos={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
occ_params={
"type": "vec4",
"value": Vector4(0, 2.1, 3.95, 0)
}
occ_box0_pos={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
occ_box0_ext={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
occ_box1_pos={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
occ_box1_ext={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}

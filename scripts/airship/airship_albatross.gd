static func _snapshot_node(n: Node3D) -> Dictionary:
	var rec := {
		"name": n.name,
		"xf": n.transform,
		"cutaway": str(n.get_meta("cutaway_group")) if n.has_meta("cutaway_group") else "",
		"prop": n.has_meta("is_propeller"),
		"meshes": [],
		"labels": [],
		"children": [],
	}
	for ch in n.get_children():
		if ch is MeshInstance3D:
			var mi: MeshInstance3D = ch
			if mi.mesh != null:
				(rec["meshes"] as Array).append({
					"name": mi.name,
					"mesh": mi.mesh,
					"mat": mi.material_override,
					"xf": mi.transform,
					"shadow": mi.cast_shadow,
					"layers": mi.layers,
					"gi": mi.gi_mode,
				})
		elif ch is Label3D:
			var lb: Label3D = ch
			(rec["labels"] as Array).append({
				"name": lb.name,
				"text": lb.text,
				"xf": lb.transform,
				"font_size": lb.font_size,
				"pixel_size": lb.pixel_size,
				"modulate": lb.modulate,
				"outline_size": lb.outline_size,
				"outline_modulate": lb.outline_modulate,
				"shaded": lb.shaded,
				"double_sided": lb.double_sided,
				"no_depth_test": lb.no_depth_test,
			})
		elif ch is Node3D:
			(rec["children"] as Array).append(_snapshot_node(ch as Node3D))
	return rec


static func _rebuild_from_blueprint(rec: Dictionary, parent: Node3D) -> Node3D:
	var n := Node3D.new()
	n.name = str(rec["name"])
	n.transform = rec["xf"] as Transform3D
	var cg := str(rec["cutaway"])
	if cg != "":
		n.set_meta("cutaway_group", cg)
	if bool(rec["prop"]):
		n.set_meta("is_propeller", true)
	parent.add_child(n)
	for mrec: Dictionary in (rec["meshes"] as Array):
		var mi := MeshInstance3D.new()
		mi.name = str(mrec["name"])
		mi.mesh = mrec["mesh"] as Mesh
		mi.material_override = mrec["mat"] as Material
		mi.transform = mrec["xf"] as Transform3D
		mi.cast_shadow = int(mrec["shadow"]) as GeometryInstance3D.ShadowCastingSetting
		mi.layers = int(mrec["layers"])
		mi.gi_mode = int(mrec["gi"]) as GeometryInstance3D.GIMode
		n.add_child(mi)
	for lrec: Dictionary in (rec["labels"] as Array):
		var lb := Label3D.new()
		lb.name = str(lrec["name"])
		lb.text = str(lrec["text"])
		lb.transform = lrec["xf"] as Transform3D
		lb.font_size = int(lrec["font_size"])
		lb.pixel_size = float(lrec["pixel_size"])
		lb.modulate = lrec["modulate"] as Color
		lb.outline_size = int(lrec["outline_size"])
		lb.outline_modulate = lrec["outline_modulate"] as Color
		lb.shaded = bool(lrec["shaded"])
		lb.double_sided = bool(lrec["double_sided"])
		lb.no_depth_test = bool(lrec["no_depth_test"])
		n.add_child(lb)
	for crec: Dictionary in (rec["children"] as Array):
		_rebuild_from_blueprint(crec, n)
	return n


## 构建完整 87.2m 信天翁号，并将游戏既有 3D 场景精确装配至对应舱位：
##   - Cabin_PortholeOBS2 ← 既有主菜单 OBS-2 观景舷窗舱（scripts/menu_ship.gd）
##   - Cabin_HangarBay03  ← 既有机库 BAY 03 重型机甲整备舱（scripts/airship/bay03_hangar.gd）
## 保证在 legacy_obs2 / legacy_bay03 模式下既有视觉效果零改动，同时支持一键切换 full_exterior / starboard_cutaway / interior_only。
static func build_integrated(opts := {}) -> Node3D:
	var replace_obs2: bool = bool(opts.get("replace_obs2", true))
	var replace_bay03: bool = bool(opts.get("replace_bay03", true))
	var obs2_exact: bool = bool(opts.get("obs2_exact_origin", false))
	var obs2_fit: bool = bool(opts.get("obs2_fit_airship", true))
	var obs2_lights: bool = bool(opts.get("include_obs2_lights", true))
	var obs2_outside: bool = bool(opts.get("include_obs2_outside", not obs2_fit))
	var bay03_fit: bool = bool(opts.get("bay03_fit_airship", true))
	var bay03_lights: bool = bool(opts.get("include_bay03_lights", true))
	var bay03_mob: bool = bool(opts.get("bay03_mob", OS.has_feature("mobile")))
	var bay03_mob_ren: bool = bool(opts.get("bay03_mob_ren", RenderingServer.get_current_rendering_method() == "mobile"))
	var do_batch: bool = bool(opts.get("batch_static", true))

	var root: Node3D
	var from_cache := do_batch and replace_obs2 and replace_bay03 and not _shell_blueprint.is_empty()
	if from_cache:
		# 极速蓝图重建：直接实例化已合批的 ~79 个母舰网格与相机锚点，跳过 3050 网格构建与合批
		root = Node3D.new()
		root.name = "AlbatrossIII_AirshipCarrier"
		for rec: Dictionary in _shell_blueprint:
			_rebuild_from_blueprint(rec, root)
		var mk_pad := Marker3D.new()
		mk_pad.name = "MechPad_Anchor"
		mk_pad.position = _mech_pad_pos
		root.add_child(mk_pad)
		root.set_meta("MechPad_Anchor", mk_pad)
		var mroot := Node3D.new()
		mroot.name = "Airship_GodotMarkers"
		root.add_child(mroot)
		for mrec: Dictionary in _marker_blueprint:
			var mk := Marker3D.new()
			mk.name = str(mrec["name"])
			mk.position = mrec["pos"] as Vector3
			mk.set_meta("look_at", mrec["look_at"] as Vector3)
			mroot.add_child(mk)
			root.set_meta(mk.name, mk)
	else:
		root = build()
		if replace_obs2:
			var old_obs2 := root.get_node_or_null("Cabin_PortholeOBS2")
			if old_obs2 != null:
				root.remove_child(old_obs2)
				old_obs2.free()
		if replace_bay03:
			var old_bay := root.get_node_or_null("Cabin_HangarBay03")
			if old_bay != null:
				root.remove_child(old_bay)
				old_bay.free()
		if do_batch:
			_batch_airship_subsystems(root)
			if replace_obs2 and replace_bay03 and _shell_blueprint.is_empty():
				for ch in root.get_children():
					if not (ch is Node3D):
						continue
					var n3: Node3D = ch
					if n3.name == "Airship_GodotMarkers" or n3.name == "MechPad_Anchor":
						continue
					_shell_blueprint.append(_snapshot_node(n3))
				var pad_mk = root.get_meta("MechPad_Anchor", null)
				if pad_mk is Marker3D:
					_mech_pad_pos = (pad_mk as Marker3D).position
				var mroot_n := root.get_node_or_null("Airship_GodotMarkers")
				if mroot_n != null:
					for mk in mroot_n.get_children():
						if mk is Marker3D:
							_marker_blueprint.append({
								"name": mk.name,
								"pos": (mk as Marker3D).position,
								"look_at": mk.get_meta("look_at", Vector3.ZERO),
							})

	# 1) 挂载游戏既有主菜单观景舱（menu_ship.gd）
	if replace_obs2:
		var obs2_anchor := Node3D.new()
		obs2_anchor.name = "OBS2_Anchor"
		obs2_anchor.position = OBS2_MOUNT_POS_EXACT if obs2_exact else OBS2_MOUNT_POS
		root.add_child(obs2_anchor)
		var obs2_refs := MenuShip.build(obs2_anchor, {
			"include_lights": obs2_lights,
			"include_outside": obs2_outside,
			"fit_airship": obs2_fit,
			"batch_static": do_batch,
		})
		root.set_meta("OBS2_Anchor", obs2_anchor)
		root.set_meta("obs2_refs", obs2_refs)

	# 2) 挂载游戏既有机库整备舱（bay03_hangar.gd），保持 MechPad_Anchor(0, 1.56, 0) 精确对齐
	if replace_bay03:
		var bay_anchor := Node3D.new()
		bay_anchor.name = "Bay03_Anchor"
		bay_anchor.position = BAY03_MOUNT_POS
		root.add_child(bay_anchor)
		var bay_refs := Bay03Hangar.build(bay_anchor, {
			"mob": bay03_mob,
			"mob_ren": bay03_mob_ren,
			"include_lights": bay03_lights,
			"fit_airship": bay03_fit,
			"batch_static": do_batch,
		})
		root.set_meta("Bay03_Anchor", bay_anchor)
		root.set_meta("bay03_refs", bay_refs)

	# 3) 缓存推进螺旋桨与飞空艇外壳阴影投射网格列表（供 legacy 视觉无损模式快速切换）
	var props: Array[Node3D] = []
	var shell_nodes: Array[Node3D] = []
	var shadow_casters: Array[MeshInstance3D] = []
	for ch in root.get_children():
		if not (ch is Node3D):
			continue
		var n3: Node3D = ch
		if n3.name == "OBS2_Anchor" or n3.name == "Bay03_Anchor" or n3.name == "Airship_GodotMarkers" or n3.name == "MechPad_Anchor":
			continue
		shell_nodes.append(n3)
		for sub in n3.find_children("*", "", true, false):
			if sub is Node3D and sub.has_meta("is_propeller"):
				props.append(sub as Node3D)
			elif sub is MeshInstance3D:
				var mi: MeshInstance3D = sub
				if mi.cast_shadow != GeometryInstance3D.SHADOW_CASTING_SETTING_OFF:
					shadow_casters.append(mi)
	root.set_meta("_propellers", props)
	root.set_meta("_shell_nodes", shell_nodes)
	root.set_meta("_shadow_casters", shadow_casters)
	return root


static func _batch_airship_subsystems(root: Node3D) -> void:
	for ch in root.get_children():
		if not (ch is Node3D):
			continue
		var sub: Node3D = ch
		if sub.name == "OBS2_Anchor" or sub.name == "Bay03_Anchor" or sub.name == "Airship_GodotMarkers" or sub.name == "MechPad_Anchor":
			continue
		var keep_nodes: Array = []
		for d in sub.find_children("*", "Node3D", true, false):
			if d.has_meta("cutaway_group") or d.has_meta("is_propeller"):
				keep_nodes.append(d)
		if not keep_nodes.is_empty():
			sub.set_meta("_keep_airship_parts", keep_nodes)
		MechScript._batch_visual(sub)
		if sub.has_meta("_keep_airship_parts"):
			sub.remove_meta("_keep_airship_parts")


static func _set_shell_shadows(root: Node3D, enabled: bool) -> void:
	if not root.has_meta("_shadow_casters"):
		return
	var mode := GeometryInstance3D.SHADOW_CASTING_SETTING_ON if enabled else GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	for mi in root.get_meta("_shadow_casters"):
		if is_instance_valid(mi):
			(mi as MeshInstance3D).cast_shadow = mode


static func spin_propellers(root: Node3D, delta: float, speed := 10.0) -> void:
	if root == null or not root.has_meta("_propellers"):
		return
	for p in root.get_meta("_propellers"):
		if is_instance_valid(p):
			(p as Node3D).rotation.x += delta * speed


static func set_cutaway_mode(root: Node3D, mode: String) -> void:
	if root == null:
		return
	var obs2_anchor: Node3D = root.get_meta("OBS2_Anchor", null)
	var bay_anchor: Node3D = root.get_meta("Bay03_Anchor", null)
	var bay_root: Node3D = null
	if root.has_meta("bay03_refs"):
		var br: Dictionary = root.get_meta("bay03_refs")
		bay_root = br.get("root", null)

	if mode == "legacy_obs2":
		# 主菜单既有视觉 100% 无损模式：保留既有 OBS-2 原样与原阴影；屏蔽外部船体阴影投射与挡窗外壳
		if obs2_anchor != null:
			obs2_anchor.visible = true
			MenuShip.set_airship_fit(obs2_anchor, false)
		if bay_anchor != null:
			bay_anchor.visible = true
		if bay_root != null:
			Bay03Hangar.set_airship_fit(bay_root, true)
		_set_shell_shadows(root, false)
		if root.has_meta("_shell_nodes"):
			for sn in root.get_meta("_shell_nodes"):
				var n3: Node3D = sn
				if is_instance_valid(n3):
					n3.visible = (n3.name != "Hull_PortArmorShell" and n3.name != "Propulsion_PortNacelles")
		for ch in root.find_children("*", "Node3D", true, false):
			if not ch.has_meta("cutaway_group"):
				continue
			var g: String = str(ch.get_meta("cutaway_group"))
			if g == "port_shell":
				ch.visible = false
			else:
				ch.visible = true
		return

	if mode == "legacy_bay03":
		# 机库既有视觉 100% 无损模式：保留既有 BAY 03 原布局（后壁 Z=-9.6、宽展甲板与原灯光反射），屏蔽与旧镜头重叠的飞空艇外壳
		if bay_anchor != null:
			bay_anchor.visible = true
		if bay_root != null:
			Bay03Hangar.set_airship_fit(bay_root, false)
		if obs2_anchor != null:
			obs2_anchor.visible = false
			MenuShip.set_airship_fit(obs2_anchor, true)
		_set_shell_shadows(root, false)
		if root.has_meta("_shell_nodes"):
			for sn in root.get_meta("_shell_nodes"):
				if is_instance_valid(sn):
					(sn as Node3D).visible = false
		return

	# 完整飞空艇模式：full_exterior / starboard_cutaway / interior_only
	if root.has_meta("_shell_nodes"):
		for sn in root.get_meta("_shell_nodes"):
			if is_instance_valid(sn):
				(sn as Node3D).visible = true
	if obs2_anchor != null:
		obs2_anchor.visible = true
		MenuShip.set_airship_fit(obs2_anchor, true)
	if bay_anchor != null:
		bay_anchor.visible = true
	if bay_root != null:
		Bay03Hangar.set_airship_fit(bay_root, true)
	_set_shell_shadows(root, true)
	for ch in root.find_children("*", "Node3D", true, false):
		if not ch.has_meta("cutaway_group"):
			continue
		var g: String = str(ch.get_meta("cutaway_group"))
		match g:
			"starboard_shell", "upper_envelope_starboard":
				ch.visible = (mode == "full_exterior")
			"upper_envelope_port", "gondola_roof":
				ch.visible = (mode == "full_exterior" or mode == "starboard_cutaway")
			"port_shell":
				ch.visible = (mode != "interior_only")

static func set_cutaway_mode(root: Node3D, mode: String) -> void:
	for ch in root.get_children():
		var cg := str(ch.get_meta("cutaway_group", "core"))
		if mode == "roof_cutaway":
			ch.visible = cg != "roof_cap"
		elif mode == "front_cutaway":
			ch.visible = cg != "roof_cap" and cg != "front_wall"
		else:
			ch.visible = true
		if ch.visible and ch is Node3D:
			set_cutaway_mode(ch, mode)
